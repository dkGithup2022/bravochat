# ========================================
# Bravo Chat FE — 환경 변수 템플릿
# 1. 이 파일을 .env.local 로 복사
# 2. 값 채우기
# 3. .env.local 은 커밋 금지
# ========================================

# 실제 BE 주소 (서버 전용, 프록시가 사용). 목 모드에선 불필요.
BACKEND_API_URL=http://localhost:8080

# 목 모드: true=목 데이터 / false=실제 BE 프록시
NEXT_PUBLIC_USE_MOCK=true

# (선택) 앱 base URL. 기본 http://localhost:3000
# NEXT_PUBLIC_BASE_URL=http://localhost:3000
